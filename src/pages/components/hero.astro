---
import Header from "./header.astro";
import { CircleCheckBig } from "@lucide/astro";
import realEstateBg from "../../assets/real-estate.jpg";
---

<section
  class="relative min-h-screen w-full overflow-hidden bg-cover bg-center bg-no-repeat flex flex-col justify-between"
  style={`background-image: url('${realEstateBg.src}');`}
>
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/75 sm:bg-black/65 pointer-events-none"></div>

  <!-- Content Wrapper -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-6 sm:py-10 flex flex-col min-h-screen">
    <!-- Navigation Header -->
    <Header />

    <!-- Main Hero Body Grid -->
    <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center py-12 lg:py-0">
      <!-- Left Column: Heading, Subtitle & Primary CTA -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 sm:space-y-8">
        <!-- Tagline / Badge -->
        <span class="text-xs sm:text-sm font-semibold tracking-wider text-gray-300 uppercase bg-white/10 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/20">
          Premier Real Estate
        </span>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight sm:leading-snug">
          Find a Space That Speaks to Your Vision.
        </h1>

        <!-- Subtitle Paragraph -->
        <p class="text-base sm:text-lg text-gray-200 font-normal leading-relaxed max-w-2xl">
          Whether you’re searching for a modern urban home, an expansive family
          estate, or a strategic commercial investment, we match extraordinary
          properties with discerning clients.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto pt-2">
          <a
            href="#explore"
            class="inline-flex items-center justify-center bg-white font-semibold text-black px-8 py-3.5 rounded-full hover:bg-gray-100 transition-all duration-200 shadow-lg hover:scale-105 active:scale-95 text-center"
          >
            Explore Properties
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center border border-white/30 bg-white/10 backdrop-blur-sm font-semibold text-white px-8 py-3.5 rounded-full hover:bg-white/20 transition-all duration-200 text-center"
          >
            Contact Agent
          </a>
        </div>
      </div>

      <!-- Right Column: Social Proof Metrics Card -->
      <div class="lg:col-span-5 lg:pl-8">
        <div class="bg-black/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 space-y-4 sm:space-y-5">
          <div class="flex items-center gap-3.5 text-white font-medium text-sm sm:text-base">
            <CircleCheckBig class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-400 shrink-0" />
            <span>$250M+ Total Property Volume Closed</span>
          </div>

          <div class="flex items-center gap-3.5 text-white font-medium text-sm sm:text-base">
            <CircleCheckBig class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-400 shrink-0" />
            <span>98% Client Satisfaction Rate</span>
          </div>

          <div class="flex items-center gap-3.5 text-white font-medium text-sm sm:text-base">
            <CircleCheckBig class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-400 shrink-0" />
            <span>12+ Years Local Market Leadership</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Gradient Transition -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-32 sm:h-48
           bg-gradient-to-t from-white via-white/20 to-transparent opacity-90"
  ></div>
</section>
