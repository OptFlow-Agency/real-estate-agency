---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import Family from "../../assets/house-family.jpg";
---

<section class="relative min-h-[480px] sm:min-h-[560px] w-full flex items-center justify-center text-center px-5 sm:px-8 lg:px-12 py-16 sm:py-24 overflow-hidden">
  <!-- Image Container with Astro Image Optimization -->
  <div class="absolute inset-0 z-0">
    <Image
      src={Family}
      alt="Family in front of their house"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      quality={90}
      format="webp"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <!-- Dark Overlay for Contrast & Readability -->
    <div class="absolute inset-0 bg-black/60 sm:bg-black/55 pointer-events-none"></div>
  </div>

  <!-- Content Wrapper -->
  <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
    <!-- Optional Badge -->
    <span class="text-xs sm:text-sm font-semibold tracking-wider text-gray-300 uppercase bg-white/10 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/20 mb-6">
      Take the Next Step
    </span>

    <!-- Main Heading -->
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight mb-8 sm:mb-10">
      Find Your Space.{" "}
      <span class="text-gray-300 font-normal block sm:inline">
        We'll Help You Get There.
      </span>
    </h2>

    <!-- CTA Button -->
    <a
      href="#contact"
      class="inline-flex items-center gap-3 bg-white text-gray-900 font-semibold px-8 py-4 rounded-full hover:bg-gray-100 hover:scale-105 active:scale-95 transition-all duration-200 text-sm sm:text-base shadow-xl group"
    >
      <span>Let's get started</span>
      <ArrowRight class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-200 group-hover:translate-x-1" />
    </a>
  </div>
</section>
